                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMedico}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"dataHora\": \"2030-12-25T14:00:00\",\n  \"observacoes\": \"Consulta criada para teste de integração RabbitMQ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/consultas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "consultas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('consultaId', pm.response.json().id);",
                  "}",
                  "",
                  "pm.test('Consulta criada para teste de integração', function () {",
                  "    pm.expect([201, 400, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}